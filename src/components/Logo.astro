---
const { class: className } = Astro.props;
---

<span class:list={["logo-initials", className]} aria-hidden="true">EY</span>

<style>
  .logo-initials {
    @apply inline-flex items-center justify-center rounded-lg bg-theme-accent font-mono text-lg font-bold;
    color: #fff;
    width: 2.25rem;
    height: 2.25rem;
  }
</style>
