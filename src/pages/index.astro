---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/PostCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";
import { IconArrowRight } from "@tabler/icons-react";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main>
    <section class="py-12">
      <div class="prose text-lg">
        <p>
          I'm Eugene Yakhnenko. I build products, and the systems and
          tooling that let a team ship them faster. Authentication, real-time collaboration,
          language runtimes, and developer tooling.
          Currently working on <a href="https://getautentico.dev">Autentico</a>
          (self-hosted OIDC provider) and <a href="https://tttedit.dev">TTT</a>
          (a terminal IDE). Outside of code, I like
          <a href="https://eugenioenko.github.io/photography/">photography</a>,
          plants, and oil painting.
        </p>
        <p>
          I write about OAuth and identity, frontend architecture, JavaScript
          and TypeScript patterns, performance, and building things with Go.
        </p>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Featured</h2>
            <ul>
              {featuredPosts.map(({ data }) => (
                <Card
                  href={`/posts/${data.slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${data.slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="flex justify-center pb-8">
      <LinkButton className="flex" href="/posts/">
        View All Posts
        <IconArrowRight />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
