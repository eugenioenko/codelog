---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";
---

<Layout title={`About | ${SITE.title}`}>
  <Header activeNav="about" />
  <main>
    <section id="about" class="prose mb-28 max-w-[52rem]">
      <h1 class="pt-6 text-2xl tracking-wider sm:text-3xl">About</h1>
      <p>
        I’m Eugene Yakhnenko, a software engineer with over ten years in
        the industry, currently at
        <a href="https://www.virtru.com/">Virtru</a>, where I work on
        frontend platforms, developer tooling, and platform standards.
        I also contribute to
        <a href="https://github.com/opentdf/platform">OpenTDF</a>.
        I care as much about the person using what I build, whether an end
        user or another engineer, as about the architecture underneath.
      </p>
      <p>
        You can download my <a href="/EugeneYakhnenko.pdf">resume</a>.
      </p>
      <p>
        Outside of work, I build open-source tools:
        <a href="https://tttedit.dev">TTT</a> (a terminal IDE),
        <a href="https://getautentico.dev">Autentico</a> (an OIDC identity
        provider), and <a href="https://kasperjs.top">kasper-js</a> (a
        reactive framework). When I’m not writing code, I’m into
        <a href="https://eugenioenko.github.io/photography/">photography</a>,
        plants, and oil painting.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
